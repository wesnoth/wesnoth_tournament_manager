# Dependencies
node_modules/
.venv
venv/

# Build outputs
backend/dist/
backend/build/
frontend/dist/
frontend/build/

# Environment files (keep .env.example files)
.env
.env.local
backend/.env
backend/.env.local
backend/.env.dev
backend/.env.development
backend/.env.migration
backend/.env.test
backend/.env.production
frontend/.env
frontend/.env.local
frontend/.env.migration
frontend/.env.dev
frontend/.env.development
frontend/.env.staging
frontend/.env.main
frontend/.env.test
frontend/.env.production

# Migration data files (CSV exports, sensitive data)
backend/migrations/manual_migrations/

# Log files
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# IDE files
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# GitHub configuration
.github/

# Codex / local skills (never commit skill implementations or metadata)
.github/skills/
.codex/skills/
**/skills/

# End-to-end test sources are versioned; generated authentication state and
# reports remain local because they can contain session credentials.
/e2e/*
!/e2e/auth.setup.ts
!/e2e/tournaments/
/e2e/tournaments/*
!/e2e/tournaments/ranked-elimination.spec.ts
/e2e/.auth/
/testing/results/
/testing/scripts/test_credentials.csv
/testing/scripts/test_tournament.ps1
/backend/test_credentials.csv

# Runtime
uploads/
replays/
temp/
tmp/

# Generated from the tracked Wesnoth avatar PNG files during the backend build.
frontend/public/wesnoth-avatars/manifest.json

# Database
*.db
*.sqlite
*.sqlite3

# Generated script inputs and exports. Keep reviewed maintenance utilities public.
/scripts/*
!/scripts/clone_tournament_db.sh
!/scripts/check_licenses.js
!/scripts/countries_insert.sql
!/scripts/extract_wesnoth_avatars.ps1
!/scripts/generate_countries_sql.py
!/scripts/generate_wesnoth_manifest.py
!/scripts/normalize_avatar_filenames.py
wesnoth_avatars.json
playwright-report/
wiki-artifacts/
.wiki-tmp/
test-results/
